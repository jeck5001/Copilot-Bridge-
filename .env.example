# Copy this file to .env only when you need to override a default.
# .env is ignored by Git. Never commit real credentials or account data.

# Local-only by default. For a public server, keep 127.0.0.1 and put a TLS
# reverse proxy in front. Use 0.0.0.0 only when you understand the exposure.
M365_BIND_ADDRESS=127.0.0.1
M365_PORT=4141

# Public bootstrap credential. The console blocks all management operations
# until it is changed to a password of at least 12 characters.
M365_ADMIN_PASSWORD=admin888

# false for local HTTP; true behind an HTTPS reverse proxy.
M365_COOKIE_SECURE=false

M365_LOG_LEVEL=warn
M365_CHAT_TIMEOUT_SECONDS=600
M365_IMAGE_TIMEOUT_SECONDS=150
M365_MAX_REQUEST_BODY_BYTES=8388608
M365_MAX_TOOL_ROUNDS=64
M365_MAX_TOOL_CALLS_PER_TURN=4
